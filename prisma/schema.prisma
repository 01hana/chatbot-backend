generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// System-wide configuration key-value store.
/// All runtime-tunable thresholds and text are stored here.
model SystemConfig {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

// ─── Phase 1: Safety ─────────────────────────────────────────────────────────

/// Prompt-injection and jailbreak detection patterns.
model SafetyRule {
  id        Int      @id @default(autoincrement())
  type      String   /// e.g. "prompt_injection" | "jailbreak" | "confidential"
  pattern   String   /// regex string or plain keyword
  isRegex   Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("safety_rules")
}

/// Confidential / sensitive keyword blacklist.
model BlacklistEntry {
  id        Int      @id @default(autoincrement())
  keyword   String   @unique
  type      String   /// confidential | internal | pricing_sensitive
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("blacklist_entries")
}

// ─── Phase 1: Intent ─────────────────────────────────────────────────────────

/// Intent classification templates including follow-up question templates.
model IntentTemplate {
  id          Int      @id @default(autoincrement())
  intent      String   @unique /// e.g. "product-inquiry"
  label       String   /// human-readable label
  keywords    String[] /// keyword hints used for detection
  templateZh  String   /// follow-up question template (zh-TW)
  templateEn  String   /// follow-up question template (en)
  priority    Int      @default(0)
  /// Whether this template is active; inactive templates are excluded from intent detection.
  isActive    Boolean  @default(true)
  /// Product/topic category for routing, e.g. "product-spec" | "faq-general" | "pricing".
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("intent_templates")
}

/// Product glossary — term aliases and synonym mapping.
model GlossaryTerm {
  id          Int      @id @default(autoincrement())
  term        String   @unique
  synonyms    String[] /// alternate forms / abbreviations
  intentLabel String?  /// associated intent (optional)
  createdAt   DateTime @default(now())

  @@map("glossary_terms")
}

// ─── Phase 1: Knowledge ──────────────────────────────────────────────────────

/// Knowledge base entries used for RAG retrieval.
model KnowledgeEntry {
  id          Int               @id @default(autoincrement())
  title       String
  content     String
  intentLabel String?
  tags        String[]
  /// FAQ question variants and natural-language aliases for this entry.
  /// Storing common user phrasings here enables FAQ-friendly ILIKE retrieval.
  aliases     String[]          @default([])
  /// ISO language tag for this entry — used for language-aware retrieval. zh-TW | en
  language    String            @default("zh-TW")
  status      String            @default("draft") /// draft | published | archived
  visibility  String            @default("private") /// public | private
  version     Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  // ── 002 KS-001: structured fields ─────────────────────────────────────────
  /// Stable slug identifier for cross-language grouping and seed upserts.
  /// NULL-safe: multiple rows with sourceKey=NULL do not trigger the unique constraint.
  sourceKey             String?
  /// Product/topic category: product-spec | faq-general | pricing | contact | diagnosis
  category              String?
  /// Determines which answer path the pipeline uses for this entry.
  /// template | rag+template | rag | llm — defaults to "rag" (001-compatible behaviour).
  answerType            String            @default("rag")
  /// Points to a template key used by AnswerTemplateResolver (002 Phase C).
  templateKey           String?
  /// Common FAQ question phrasings for this entry (used in faq retrieval scoring).
  faqQuestions          String[]          @default([])
  /// Groups semantically equivalent entries across languages.
  crossLanguageGroupKey String?
  /// Arbitrary structured metadata (e.g. spec dimensions, pricing tiers).
  structuredAttributes  Json?

  versions    KnowledgeVersion[]

  /// Unique per (sourceKey, language) when sourceKey is not null.
  /// PostgreSQL treats NULL as distinct, so rows with sourceKey=NULL are exempt.
  @@unique([sourceKey, language])
  @@map("knowledge_entries")
}

/// Immutable version snapshots of KnowledgeEntry content.
model KnowledgeVersion {
  id             Int            @id @default(autoincrement())
  knowledgeEntry KnowledgeEntry @relation(fields: [knowledgeEntryId], references: [id])
  knowledgeEntryId Int
  versionNumber  Int
  contentSnapshot String
  createdAt      DateTime       @default(now())

  @@map("knowledge_versions")
}

// ─── Phase 2: Conversation ────────────────────────────────────────────────────

/// A chat session, identified externally by `session_token` (UUID).
/// The `sessionId` field is the internal unique string key; `session_token` is
/// what the frontend stores and sends to all Chat API endpoints.
model Conversation {
  id                   Int                   @id @default(autoincrement())
  /// Internal UUID used inside the backend (not exposed to frontend)
  sessionId            String                @unique @default(uuid())
  /// External UUID returned to the frontend on session creation
  session_token        String                @unique @default(uuid())
  /// Session lifecycle status: active | closed
  status               String                @default("active")
  /// Conversation classification: normal | confidential
  type                 String                @default("normal")
  /// Aggregated risk level: low | medium | high | null
  riskLevel            String?
  /// Accumulated count of blocked/sensitive turns in this session
  sensitiveIntentCount Int                   @default(0)
  /// Running high-intent score for lead-capture triggering
  highIntentScore      Int                   @default(0)
  /// JSONB blob for product-diagnosis state machine context (Phase 4)
  diagnosisContext     Json?
  /// Detected language of the conversation: zh-TW | en
  language             String                @default("zh-TW")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  messages  ConversationMessage[]
  leads     Lead[]
  tickets   Ticket[]
  feedbacks Feedback[]

  @@map("conversations")
}

/// Individual messages within a Conversation.
model ConversationMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  /// Message author: user | assistant | system
  role           String
  content        String
  /// Message classification: normal | confidential | blocked
  type           String       @default("normal")
  /// Risk level of this specific message: low | medium | high | null
  riskLevel      String?
  /// Reason the message was blocked, if applicable
  blockedReason  String?
  createdAt      DateTime     @default(now())

  feedbacks      Feedback[]

  @@map("conversation_messages")
}

// ─── Phase 2: Audit ───────────────────────────────────────────────────────────

/// Append-only audit trail of all pipeline events.
/// IMPORTANT: Rows must NEVER be updated or deleted.
/// `sessionId` is a plain String reference (no FK constraint) to avoid
/// cascade-delete risks on an immutable audit table.
model AuditLog {
  id               Int      @id @default(autoincrement())
  /// X-Request-ID header value (traceability)
  requestId        String?
  /// References Conversation.sessionId (no FK — intentional)
  sessionId        String?
  /// Event type: chat_response | prompt_guard_blocked | confidential_refused |
  ///   sensitive_intent_alert | llm_fallback | lead_created | ticket_created …
  eventType        String
  /// Arbitrary JSON payload for the event
  eventData        Json?
  /// Array of KnowledgeEntry IDs used in the RAG step
  knowledgeRefs    String[] @default([])
  /// Top RAG similarity score for this turn (null when RAG was skipped)
  ragConfidence    Float?
  /// Human-readable block reason (PromptGuard / confidentiality)
  blockedReason    String?
  /// SHA-256 hex digest of the raw user input (for prompt-injection audit)
  promptHash       String?
  /// LLM token usage — 0 when LLM was not called
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  /// Actual wall-clock time for this pipeline turn in milliseconds
  durationMs       Int      @default(0)
  /// LLM model identifier (e.g. "gpt-5.4-mini") — null when LLM not called
  aiModel          String?
  /// LLM provider identifier (e.g. "openai") — null when LLM not called
  aiProvider       String?
  /// Snapshot of relevant SystemConfig values at the time of the event
  configSnapshot   Json?
  createdAt        DateTime @default(now())

  @@map("audit_logs")
}

// ─── 002 QA-003: Query Analysis Rules ────────────────────────────────────────

/// DB-managed query preprocessing rules: stop words, noise words,
/// and question-shell patterns used by DbQueryRuleProvider.
///
/// type values:
///   stop_word           — removed during normalisation (e.g. "請問", "the")
///   noise_word          — removed after tokenisation (e.g. "一些", "some")
///   question_shell_zh   — leading/trailing question-shell regex patterns (zh-TW)
///   question_shell_en   — leading/trailing question-shell regex patterns (en)
model QueryRule {
  id        Int      @id @default(autoincrement())
  /// stop_word | noise_word | question_shell_zh | question_shell_en
  type      String
  /// Language scope: zh-TW | en | all
  language  String   @default("zh-TW")
  /// The rule value: a plain word (stop/noise) or a regex pattern string (question_shell_*)
  value     String
  isActive  Boolean  @default(true)
  /// Higher priority rules are evaluated first (for question_shell ordering)
  priority  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("query_rules")
}

// ─── 003 Phase 0: Knowledge Graph (additive — do NOT modify knowledge_entries) ──

/// 003 V2 document-level knowledge container.
/// Additive: co-exists with KnowledgeEntry; no FK back to knowledge_entries.
model KnowledgeDocument {
  id          String               @id @default(cuid())
  sourceKey   String               
  title       String
  docType     KnowledgeDocType
  language    String               @default("zh-TW")
  status      String               @default("draft")  /// draft | published | archived
  visibility  String               @default("private") /// public | private
  metadata    Json?
  deletedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  chunks      KnowledgeChunk[]

  @@unique([sourceKey, language])
  @@map("knowledge_documents")
}

enum KnowledgeDocType {
  faq
  product_spec
  catalog
  company_info
  general
}

/// 003 V2 chunk — visibility is inherited from parent KnowledgeDocument.
/// KnowledgeAvailabilityChecker filters via document.visibility / document.deletedAt.
model KnowledgeChunk {
  id               String            @id @default(cuid())
  documentId       String
  document         KnowledgeDocument @relation(fields: [documentId], references: [id])
  content          String
  chunkIndex       Int
  tokenCount       Int               @default(0)
  language         String            @default("zh-TW")
  metadata         Json?
  embeddingId      String?           /// nullable in V1; used by VectorRetriever in 004+
  sourceReference  String?           /// e.g. "KnowledgeEntry:entry_id_123"
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([documentId])
  @@index([language])
  @@map("knowledge_chunks")
}

/// 003 V2 named entity extracted from knowledge documents.
model KnowledgeEntity {
  id            String               @id @default(cuid())
  name          String
  entityType    KnowledgeEntityType
  canonicalKey  String               @unique
  createdAt     DateTime             @default(now())

  fromRelations KnowledgeRelation[]  @relation("FromEntity")
  toRelations   KnowledgeRelation[]  @relation("ToEntity")

  @@map("knowledge_entities")
}

enum KnowledgeEntityType {
  product
  spec
  category
  company
}

/// 003 V2 directed relation between two KnowledgeEntity nodes.
model KnowledgeRelation {
  id           String                @id @default(cuid())
  fromEntityId String
  fromEntity   KnowledgeEntity       @relation("FromEntity", fields: [fromEntityId], references: [id])
  toEntityId   String
  toEntity     KnowledgeEntity       @relation("ToEntity", fields: [toEntityId], references: [id])
  relationType KnowledgeRelationType
  createdAt    DateTime              @default(now())

  @@index([fromEntityId])
  @@index([toEntityId])
  @@map("knowledge_relations")
}

enum KnowledgeRelationType {
  is_variant_of
  belongs_to_category
  compatible_with
  see_also
}

// ─── Phase 5: Lead / Ticket / Feedback ───────────────────────────────────────

enum LeadStatus {
  new
  contacted
  qualified
  closed
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
}

enum FeedbackValue {
  up
  down
}

/// Visitor lead captured via handoff or explicit lead form submission.
model Lead {
  id                       Int          @id @default(autoincrement())
  /// FK to Conversation.id
  conversationId           Int
  conversation             Conversation @relation(fields: [conversationId], references: [id])
  /// Visitor name — required
  name                     String
  /// Visitor email — required
  email                    String
  /// Visitor company name — optional
  company                  String?
  /// Visitor phone number — optional
  phone                    String?
  /// Visitor's original message / inquiry — optional
  message                  String?
  /// Frontend language at time of submission: zh-TW | en
  language                 String?
  /// Conversation classification copied from Conversation: general | confidential
  type                     String       @default("general")
  /// Risk level copied from Conversation: low | medium | high | null
  riskLevel                String?
  /// Whether a confidentiality keyword triggered in this session
  confidentialityTriggered Boolean      @default(false)
  /// Whether prompt injection was detected in this session
  promptInjectionDetected  Boolean      @default(false)
  /// Accumulated sensitive intent count copied from Conversation
  sensitiveIntentCount     Int          @default(0)
  /// Running high-intent score copied from Conversation
  highIntentScore          Int          @default(0)
  /// AI-generated conversation summary — populated asynchronously
  summary                  String?
  /// Reference to archived transcript storage (e.g. S3 key)
  transcriptRef            String?
  /// Notification dispatch status: pending | success | failed
  notificationStatus       String       @default("pending")
  /// Admin workflow status
  status                   LeadStatus   @default(new)
  /// Admin notes / remarks
  notes                    String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  deletedAt                DateTime?

  tickets  Ticket[]

  @@index([conversationId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

/// Support ticket created on handoff or manually by admin.
/// Status lifecycle: open → in_progress → resolved → closed
model Ticket {
  id             Int            @id @default(autoincrement())
  /// Optional FK to Lead — nullable when ticket created independently
  leadId         Int?
  lead           Lead?          @relation(fields: [leadId], references: [id])
  /// FK to Conversation.id
  conversationId Int
  conversation   Conversation   @relation(fields: [conversationId], references: [id])
  /// Four-state lifecycle
  status         TicketStatus   @default(open)
  /// Why the ticket was created: handoff | high_intent | sensitive_intent | manual
  triggerReason  String
  summary        String?
  priority       TicketPriority @default(medium)
  /// Assigned agent identifier — optional
  assignee       String?
  /// Timestamped admin notes stored as JSONB array: [{content, createdAt, author?}]
  notes          Json           @default("[]")
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  @@index([conversationId])
  @@index([leadId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("tickets")
}

/// User feedback on a specific assistant message — up or down only, no 1-5 scale.
model Feedback {
  id             Int                 @id @default(autoincrement())
  /// FK to Conversation.id
  conversationId Int
  conversation   Conversation        @relation(fields: [conversationId], references: [id])
  /// FK to ConversationMessage.id
  messageId      Int
  message        ConversationMessage @relation(fields: [messageId], references: [id])
  /// up | down — not a numeric rating
  value          FeedbackValue
  /// Optional free-text reason
  reason         String?
  createdAt      DateTime            @default(now())

  @@index([conversationId])
  @@index([messageId])
  @@map("feedbacks")
}
